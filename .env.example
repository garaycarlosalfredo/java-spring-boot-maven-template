# TEMPLATE: Copy to .env and replace the placeholders with local values.
# Spring reads this file as Java properties: KEY=value, without shell quotes.
# Double literal backslashes; use a backslash to preserve a leading space.
DB_URL=jdbc:postgresql://<db-host>:<db-port>/<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>
APP_SECURITY_USERNAME=<api-username>
APP_SECURITY_PASSWORD=<api-password>
